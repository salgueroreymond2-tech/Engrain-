generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  TECHNICIAN
  WORKSHOP_ADMIN
  DEALER_ADMIN
  PLATFORM_ADMIN
}

enum VehicleStatus {
  ACTIVE
  ARCHIVED
  TRANSFER_PENDING
}

enum VehicleDataSource {
  MANUAL
  OBD2
  WORKSHOP
  AGENCY
  IMPORTED
}

enum WorkshopMemberRole {
  ADMIN
  TECHNICIAN
  ADVISOR
}

enum WorkOrderStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EvidenceType {
  IMAGE
  VIDEO
  PDF
  INVOICE
  OBD_REPORT
}

enum DiagnosticStatus {
  PENDING
  SUCCESS
  FAILED
  PARTIAL
}

enum DiagnosticSource {
  OBD2
  MANUAL
  WORKSHOP
}

enum NotificationType {
  MAINTENANCE_DUE
  WORK_ORDER_UPDATE
  DIAGNOSTIC_READY
  PASSPORT_SHARED
  SYSTEM
}

enum PassportVisibility {
  PRIVATE
  SHAREABLE
  PUBLIC
}

enum PassportStatus {
  ACTIVE
  REVOKED
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  passwordHash         String
  role                 UserRole              @default(OWNER)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  vehicles             Vehicle[]             @relation("VehicleOwner")
  ownedWorkshops       Workshop[]            @relation("WorkshopOwner")
  workshopMemberships  WorkshopMember[]
  workOrdersCreated    WorkOrder[]           @relation("WorkOrderCreator")
  maintenancesCreated  Maintenance[]         @relation("MaintenanceCreator")
  diagnosticsCreated   Diagnostic[]          @relation("DiagnosticCreator")
  notifications        Notification[]
  conversations        ConversationMessage[]
}

model Vehicle {
  id            String             @id @default(cuid())
  ownerId       String
  vin           String             @unique @db.VarChar(17)
  plate         String?            @db.VarChar(20)
  make          String             @db.VarChar(80)
  model         String             @db.VarChar(80)
  year          Int
  mileageKm     Int                @default(0)
  status        VehicleStatus      @default(ACTIVE)
  dataSource    VehicleDataSource  @default(MANUAL)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  owner         User               @relation("VehicleOwner", fields: [ownerId], references: [id])
  workOrders    WorkOrder[]
  maintenances  Maintenance[]
  diagnostics   Diagnostic[]
  passports     Passport[]

  @@index([ownerId, status])
}

model Workshop {
  id          String           @id @default(cuid())
  ownerId     String
  name        String
  taxId       String?          @unique
  phone       String?
  address     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  owner       User             @relation("WorkshopOwner", fields: [ownerId], references: [id])
  members     WorkshopMember[]
  workOrders  WorkOrder[]
}

model WorkshopMember {
  id          String              @id @default(cuid())
  workshopId  String
  userId      String
  role        WorkshopMemberRole  @default(TECHNICIAN)
  createdAt   DateTime            @default(now())
  workshop    Workshop            @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workshopId, userId])
  @@index([userId])
}

model WorkOrder {
  id          String            @id @default(cuid())
  vehicleId   String
  workshopId  String
  createdById String
  status      WorkOrderStatus   @default(DRAFT)
  title       String
  description String?           @db.Text
  openedAt    DateTime          @default(now())
  closedAt    DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id])
  workshop    Workshop          @relation(fields: [workshopId], references: [id])
  createdBy   User              @relation("WorkOrderCreator", fields: [createdById], references: [id])
  evidences   Evidence[]

  @@index([vehicleId, status])
  @@index([workshopId, status])
}

model Maintenance {
  id          String             @id @default(cuid())
  vehicleId   String
  createdById String
  status      MaintenanceStatus  @default(SCHEDULED)
  title       String
  description String?            @db.Text
  dueDate     DateTime?
  completedAt DateTime?
  mileageKm   Int?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  vehicle     Vehicle            @relation(fields: [vehicleId], references: [id])
  createdBy   User               @relation("MaintenanceCreator", fields: [createdById], references: [id])
  evidences   Evidence[]

  @@index([vehicleId, status])
}

model Evidence {
  id            String        @id @default(cuid())
  workOrderId   String?
  maintenanceId String?
  type          EvidenceType
  storageKey    String        @unique
  fileName      String
  mimeType      String
  sizeBytes     Int
  sha256        String?       @db.VarChar(64)
  createdAt     DateTime      @default(now())
  workOrder     WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  maintenance   Maintenance?  @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([maintenanceId])
}

model Diagnostic {
  id          String            @id @default(cuid())
  vehicleId   String
  createdById String
  source      DiagnosticSource
  status      DiagnosticStatus  @default(PENDING)
  mileageKm   Int?
  dtcs        Json?
  payload     Json?
  performedAt DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id])
  createdBy   User              @relation("DiagnosticCreator", fields: [createdById], references: [id])

  @@index([vehicleId, performedAt])
}

model ConversationMessage {
  id          String    @id @default(cuid())
  userId      String
  vehicleId   String?
  role        String    @db.VarChar(20)
  content     String    @db.Text
  metadata    Json?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Notification {
  id          String            @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  body        String?           @db.Text
  data        Json?
  readAt      DateTime?
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id])

  @@index([userId, readAt, createdAt])
}

model Passport {
  id          String              @id @default(cuid())
  vehicleId   String
  publicToken String              @unique @default(cuid())
  visibility  PassportVisibility  @default(PRIVATE)
  status      PassportStatus      @default(ACTIVE)
  expiresAt   DateTime?
  snapshot    Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  vehicle     Vehicle             @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, status])
}
