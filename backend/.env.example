# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
ENABLE_SWAGGER=true

# PostgreSQL / Prisma (Supabase: use the Session pooler URL from Connect for IPv4 environments)
# Never place a real project URL or password in this file.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Authentication: replace both values with unique random strings (32+ chars) before production
JWT_ACCESS_SECRET=change-me-with-a-long-random-access-secret
JWT_REFRESH_SECRET=change-me-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Brute-force protection for register, login and refresh endpoints
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Engrain AI: `local` uses the bundled DTC catalog. Set openai-compatible only with a real endpoint and key.
# The backend falls back to local output if the configured provider is unavailable.
AI_PROVIDER=local
AI_API_BASE_URL=https://api.example.com/v1
AI_API_KEY=replace-with-a-server-side-key
AI_MODEL=gpt-4.1-mini
AI_REQUEST_TIMEOUT_MS=8000

# Public Passport links / QR codes. This must point to the frontend passport route in production.
PUBLIC_PASSPORT_URL=http://localhost:5173/passports
PASSPORT_PUBLIC_RATE_LIMIT_WINDOW_MS=900000
PASSPORT_PUBLIC_RATE_LIMIT_MAX=60

# Optional, only when a provider grants an API credential. Generate 32 random bytes and encode as base64.
# This key encrypts provider secrets before storage; never place a provider credential in source control.
EXTERNAL_CREDENTIAL_ENCRYPTION_KEY=
