# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
ENABLE_SWAGGER=true

# MySQL / Prisma
DATABASE_URL="mysql://engrain:engrain_local_password@localhost:3306/engrain"

# Authentication: replace both values with unique random strings (32+ chars) before production
JWT_ACCESS_SECRET=change-me-with-a-long-random-access-secret
JWT_REFRESH_SECRET=change-me-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
