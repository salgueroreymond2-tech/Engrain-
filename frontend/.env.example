# ENGRAIN Frontend Environment Configuration
# API Base URL - Base endpoint for backend integration
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Public URL for sharing digital passports and QR codes
VITE_PUBLIC_URL=http://localhost:5173

# Application metadata
VITE_APP_NAME="ENGRAIN — Driving Trust"
VITE_APP_VERSION="0.1.0"

# Mock Mode (Set to true to use mock adapters when backend endpoints return 501 / Reservado)
VITE_ENABLE_MOCK_FALLBACK=true
